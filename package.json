{
  "name": "fl0w",
  "version": "0.1.22",
  "module": "src/index.tsx",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.tsx",
    "download": "curl -fsSL https://raw.githubusercontent.com/jackmuva/fl0w/main/install.sh | sh",
    "build": "bun build --compile --outfile fl0w src/index.tsx",
    "install:opentui-platforms": "bun add --os=\"*\" --cpu=\"*\" @opentui/core@$(node -pe \"require('./package.json').dependencies['@opentui/core']\")",
    "build:linux-x64": "bun build --compile --target=bun-linux-x64 --define process.env.OPENTUI_LIBC='\"glibc\"' --outfile dist/fl0w-linux-x64 src/index.tsx",
    "build:linux-arm64": "bun build --compile --target=bun-linux-arm64 --define process.env.OPENTUI_LIBC='\"glibc\"' --outfile dist/fl0w-linux-arm64 src/index.tsx",
    "build:linux-x64-musl": "bun build --compile --target=bun-linux-x64-musl --define process.env.OPENTUI_LIBC='\"musl\"' --outfile dist/fl0w-linux-x64-musl src/index.tsx",
    "build:linux-arm64-musl": "bun build --compile --target=bun-linux-arm64-musl --define process.env.OPENTUI_LIBC='\"musl\"' --outfile dist/fl0w-linux-arm64-musl src/index.tsx",
    "build:darwin-x64": "bun build --compile --target=bun-darwin-x64 --outfile dist/fl0w-darwin-x64 src/index.tsx",
    "build:darwin-arm64": "bun build --compile --target=bun-darwin-arm64 --outfile dist/fl0w-darwin-arm64 src/index.tsx",
    "build:windows-x64": "bun build --compile --target=bun-windows-x64 --outfile dist/fl0w-windows-x64.exe src/index.tsx",
    "build:all": "bun run install:opentui-platforms && mkdir -p dist && bun run build:linux-x64 && bun run build:linux-arm64 && bun run build:linux-x64-musl && bun run build:linux-arm64-musl && bun run build:darwin-x64 && bun run build:darwin-arm64 && bun run build:windows-x64",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "drizzle-kit": "^1.0.0-rc.4",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/gateway": "4.0.94",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@opentui/core": "0.5.12",
    "@opentui/react": "^0.5.12",
    "@types/react": "^19.3.0",
    "ai": "^7.0.116",
    "bottleneck": "^2.19.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "react": "^19.3.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
